# Rental Cash Flow Calculator - Environment Variables
# Copy this file to .env and fill in your actual values

# Real Estate API Configuration
VITE_RAPID_API_KEY=your_rapid_api_key_here

# RentSpree API (Free tier available)
VITE_RENTSPREE_API_KEY=your_rentspree_api_key_here
VITE_RENTSPREE_BASE_URL=https://api.rentspree.com/v1

# Rental Market Data API
VITE_RENTAL_MARKET_DATA_API_KEY=your_rental_market_data_api_key_here
VITE_RENTAL_MARKET_DATA_BASE_URL=https://api.rentalmarketdata.com/v1

# RentBerry API
VITE_RENTBERRY_API_KEY=your_rentberry_api_key_here
VITE_RENTBERRY_BASE_URL=https://api.rentberry.com/v1

# Geocoding Service (Free)
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Supabase Configuration (Recommended)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Payment Configuration (Pro Subscription)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Apple Sign In Configuration
VITE_APPLE_CLIENT_ID=your_apple_service_id_here
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# Development Configuration
# VITE_ENV=development

# Production Configuration (uncomment for production)
# VITE_APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback
